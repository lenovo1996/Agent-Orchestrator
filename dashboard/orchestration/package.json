{
  "name": "@devteam-dashboard/orchestration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": "./dist/worker.js",
    "./cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog:reset": "tsx src/catalog-cli.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "flow": "tsx src/cli.ts"
  },
  "dependencies": {
    "@devteam-dashboard/shared": "*",
    "inngest": "4.18.1"
  },
  "devDependencies": {
    "@inngest/test": "1.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
