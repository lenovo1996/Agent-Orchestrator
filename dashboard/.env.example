# Dashboard Server Configuration
# ================================

# Port for the dashboard server (default: 3001)
DASHBOARD_PORT=3001

# Host/interface to bind to (default: 127.0.0.1)
# Use 0.0.0.0 to expose to all network interfaces
DASHBOARD_HOST=127.0.0.1

# CORS origin for development mode (default: *)
# Set to specific origin when frontend runs on separate dev server
DASHBOARD_CORS_ORIGIN=*

# Node environment (production | development)
# In production mode, server serves client static files from client/dist/
NODE_ENV=development
