# Generate both values before production startup:
#   openssl rand -hex 32
INNGEST_EVENT_KEY=replace_with_a_random_hex_value
INNGEST_SIGNING_KEY=replace_with_a_random_hex_value
INNGEST_DEV=0
INNGEST_BASE_URL=http://127.0.0.1:8288
INNGEST_GATEWAY_URL=ws://127.0.0.1:8289/v0/connect

DEVTEAM_AGENT_CONCURRENCY=3
DEVTEAM_AGENT_TIMEOUT=6h
DEVTEAM_BLOCKED_TTL=30d
DEVTEAM_WORKER_HEALTH_PORT=3011
DEVTEAM_WORKER_HEALTH_URL=http://127.0.0.1:3011
# DEVTEAM_RUNNER_ID defaults to the hostname.
# DEVTEAM_DB_PATH defaults to <repo>/.dev-team/workflows.db.
# DASHBOARD_CODEX_HOME defaults to CODEX_HOME, then ~/.codex.

# Codex app-server runs on the host so agents can use host tools and desktop apps.
CODEX_APP_SERVER_URL=ws://127.0.0.1:9876
DASHBOARD_APP_SERVER_AUTO_APPROVE=true

# Docker Compose settings
# CODEX_HOME defaults to ~/.codex on host
# CODEX_HOME=~/.codex
# WORKSPACE_PATH defaults to parent directory of .dev-team
# Docker uses this absolute path for both the workspace and task-flow artifacts
# so the container worker and host Codex app-server see the same paths.
# WORKSPACE_PATH=/home/phi/Projects/jinjer/PHP8
