{
  "repoRoot": ".",
  "defaultBranchPrefix": "feature",
  "outputRoot": ".dev-team/task-flows",
  "members": {
    "clarifier": {
      "role": "Spec Clarifier",
      "objective": "Read Jira ticket, linked issues, comments, Confluence specs, and produce clear requirements + open questions.",
      "model": "gpt-5.5",
      "thinking": "xhigh",
      "outputs": [
        "output/clarify.md"
      ],
      "tools": [
        "read",
        "exec",
        "memory_search",
        "memory_get"
      ]
    },
    "architect": {
      "role": "Solution Architect",
      "objective": "Inspect PHP8 repos, identify impacted modules, design safe implementation approach.",
      "model": "gpt-5.5",
      "thinking": "high",
      "outputs": [
        "output/architecture.md"
      ],
      "tools": [
        "read",
        "exec"
      ]
    },
    "planner": {
      "role": "Task Planner",
      "objective": "Break requirements and architecture into small, safe, independently verifiable tasks. Produce an ordered implementation plan with files, tests, risks, and rollback strategy.",
      "model": "gpt-5.5",
      "thinking": "high",
      "outputs": [
        "output/plan.md"
      ],
      "tools": [
        "read",
        "exec"
      ]
    },
    "implementer": {
      "role": "Code Implementer",
      "objective": "Implement plan in code, keep commits small, run relevant tests, report changed files and commands.",
      "runtime": "codex",
      "model": "gpt-5.5",
      "thinking": "high",
      "outputs": [
        "output/implementation.md"
      ],
      "tools": [
        "read",
        "write",
        "edit",
        "exec"
      ]
    },
    "verifier": {
      "role": "Code Verifier",
      "objective": "Review diff for correctness, security, regressions, style. Create and execute QA test cases. Summarize verification and prepare Jira/Slack handoff.",
      "model": "gpt-5.5",
      "thinking": "xhigh",
      "outputs": [
        "output/verification.md"
      ],
      "tools": [
        "read",
        "exec"
      ]
    }
  },
  "worktree": {
    "enabled": true,
    "baseDir": "../.dev-team-worktrees",
    "maxConcurrency": 3,
    "defaultRepos": [
      "jinjer_hr_core",
      "jinjer_hr_auth",
      "jinjer_hr_authentication",
      "jinjer_hr_jinji"
    ],
    "repos": {
      "jinjer_hr_core": "./jinjer_hr_core",
      "jinjer_hr_auth": "./jinjer_hr_auth",
      "jinjer_hr_authentication": "./jinjer_hr_authentication",
      "jinjer_hr_jinji": "./jinjer_hr_jinji"
    }
  }
}
