{
  "outputRoot": "task-flows",
  "members": {
    "apk-analyzer": {
      "role": "APK Analyst",
      "objective": "Phân tích tự động một file APK/XAPK Android, trích xuất toàn bộ thông tin kỹ thuật: framework, tech stack, permissions, activities/screens, monetization, ad networks, assets, localization. Tạo summary document chi tiết phục vụ việc clone/rebuild app.",
      "model": "free",
      "thinking": "high",
      "tools": [
        "read",
        "exec",
        "write",
        "edit",
        "web_search",
        "web_fetch"
      ],
      "outputs": [
        "output/summary.md"
      ],
      "runtime": "codex"
    },
    "apk-architect": {
      "role": "App Architect",
      "objective": "Từ APK analysis summary, tạo clone-spec.md — tài liệu spec chi tiết nhất để developer có thể rebuild lại app từ đầu. Bao gồm: tech stack recommendation, screen architecture, feature specifications, data models, API design, monetization integration, localization strategy.",
      "model": "gpt-5.5",
      "thinking": "high",
      "tools": [
        "read",
        "exec",
        "write",
        "edit",
        "web_search",
        "web_fetch"
