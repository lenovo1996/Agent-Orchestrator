        const click_step = $(this).find('.step_num').text();
        if (click_step && step <= current_step && click_step < step) {
            const back_step = (parseInt(step) - 1);
            if (back_step > 0) {
                if (type == '6' || menu_selection == 'workflow' || menu_selection == 'project' || menu_detail == 'accounting_dept' || menu_selection == 'setting_keihi' || menu_selection == insurance_menu) {
