                $('.select-template').show();
                yr_end_display_using_formula_select($menuDetails);
                generate_option_template(menu, $('.menu-templates'), false, $("input[name='import[type]']").val());
                break;
            case 'setting_company':
                generate_option_menu(menu_selection[menu]['detail'], $('.menu_details'));
                $('.menu_details').removeClass('disabled').parents('.selectbox').show();
                OptionType.hide();
                currentEle.find('.import--type')[0].checked = true;
                $('.select-template').show();
                currentEle.find('input[name="import[type]"][value="3"]').prop('checked', true);
                generate_option_template(menu, $('.menu-templates'), false, $("input[name='import[type]']").val());
                break;
            case 'setting_keihi':
                $('.import_format_item_keihi').show();
                generate_option_menu(menu_selection[menu]['detail'], $('.menu_details'));
                $('.menu_details').removeClass('disabled').parents('.selectbox').show();
                $('.import_format_item_keihi').find('.option-type-import').hide();
                $('.import_format_item_keihi').find('.import--type')[0].checked = true;
                $('.select-template').hide();
                $('.import_format_item_keihi').find('#type-add, #type-update').hide();
                $('.import_format_item_keihi').find('select[name="import[template_id]"]').val('');
                $('.import_format_item_keihi').find('input[name="import[type]"][value="3"]').prop('checked', true);
                generate_option_template(menu, $('.menu-templates'), false, $("input[name='import[type]']").val());
                $('#btnNextStep').attr('data-step', 4);
                break;
            case insurance_menu:
                generate_option_menu(menu_selection[menu]['detail'], $('.menu_details'));
                $('.select-template').hide();
                $('.menu_details').removeClass('disabled').trigger('change').parents('.selectbox').show();
                $('#btnNextStep').attr('data-step', 4);
                break;
            case 'project':
                $('.menu_details').addClass('disabled').html('').parents('.selectbox').hide();
                $('.select-template').hide();
                currentEle.find('select[name="import[template_id]"]').val('');
                currentEle.find('input[value="3"]').prop("checked", true);
                $('#btnNextStep').attr('data-step', 4);
                generate_option_template(menu, $('.menu-templates'), false, $("input[name='import[type]']").val());
                break;
            case MENU_IMPORT_KINTAI_V2:
                generate_option_menu(menu_selection[menu]['detail'], $('.menu_details'));
                $('.menu_details').removeClass('disabled').parents('.selectbox').show();
                currentEle.find('input[value="1"]').prop("checked", true);
                $('.select-template').hide();
                break;
        }
        handleShowMidItems(isShowMidItems);
        if(isSelectedMidItemResidentTax()) {
            monitorMidItemSelection();
        }
    });

