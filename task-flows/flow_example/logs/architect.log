    public function resolve(string $menuDetail): ?array
    {
        $schema = self::SCHEMAS[$menuDetail] ?? null;
        if ($schema === null) {
            return null;
        }

        $schema['menu_detail'] = $menuDetail;
        $schema['fields'] = $schema['fields'] ?? self::COMMON_FIELDS;
        $schema['headers'] = array_values($schema['fields']);

        return $schema;
    }

    public function isSupported(string $menuDetail): bool
    {
        return $this->resolve($menuDetail) !== null;
    }

    public function validateCsvHeaders(string $menuDetail, array $selectedFields, array $csvHeaders): array
    {
        $schema = $this->resolve($menuDetail);
        if ($schema === null) {
            return ['対象外のマスタ設定です。'];
        }

        $selectedFields = array_map(static fn ($field) => trim((string) $field), $selectedFields);
        $csvHeaders = array_map(static fn ($header) => trim_space_japanese($header), $csvHeaders);
        $schemaFields = $this->resolveHeaderFields($schema, $selectedFields, $csvHeaders);
        if ($schemaFields === null) {
            return ['CSVヘッダーが正しくありません。'];
        }

        if (
            count($selectedFields) !== count($schemaFields)
            || count($csvHeaders) !== count($schemaFields)
            || array_diff($selectedFields, array_keys($schemaFields))
            || array_diff(array_keys($schemaFields), $selectedFields)
        ) {
            return ['CSVヘッダーが正しくありません。'];
        }

        foreach ($selectedFields as $index => $field) {
            $expectedHeaders = self::FIELD_HEADER_ALIASES[$field] ?? [$schemaFields[$field] ?? null];
            if (!in_array($csvHeaders[$index] ?? '', $expectedHeaders, true)) {
                return ['CSVヘッダーが正しくありません。'];
            }
        }

        return [];

