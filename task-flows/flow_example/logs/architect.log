    if (window.File) {
        var dropFileArea = document.getElementById('dropFileArea');
        var dropFileArea2 = document.getElementById('dropFileArea2');
        // エリア内にドラッグされたとき
        dropFileArea.addEventListener('dragover', function (e) {
            e.stopPropagation();
            e.preventDefault();
        }, false);
        // エリア内にドロップされたとき
        dropFileArea.addEventListener('drop', function (e) {
            e.stopPropagation();
            e.preventDefault();
            var fileData = e.dataTransfer.files;
            $("#dropFileArea").text(fileData[0].name);
            document.getElementById('fileupload').files = fileData;
            return false;
        }, false);

        // エリア内にドラッグされたとき
        dropFileArea2.addEventListener('dragover', function (e) {
            e.stopPropagation();
            e.preventDefault();
        }, false);
        // エリア内にドロップされたとき
        dropFileArea2.addEventListener('drop', function (e) {
            e.stopPropagation();
            e.preventDefault();
            var fileData = e.dataTransfer.files;
            $("#dropFileArea2").text(fileData[0].name);
            document.getElementById('zipfileupload').files = fileData;
            return false;
        }, false);
    }

