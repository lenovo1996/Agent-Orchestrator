    function CheckStep2Upload()
    {
        var import_type = $('input[name="import[type]"]:checked').val();
        if (import_type == TYPE_UPLOAD_ZIP) {
            $('.select-upload-file').show();
            $('#zipSelect').removeClass('disabled');
        } else {
            $('.select-upload-file').hide();
            $('#zipSelect').addClass('disabled');
        };
    }

    /**
     * バリデーション
     * @returns {boolean} true: OK, false: NG
     */
    function ValidateChooseTypeHistory()
    {
        var import_type = $('input[name="import[type]"]:checked').val();
        var template_id = $('select[name="import[template_id]"]').val();
        if (TYPE_UPLOAD_HISTORY.includes(import_type) && template_id == 0) {
            show_alert('.content-alert', ['テンプレートを選択してください。'], 'alert-danger');
            return false;
        }

        var menu_selection = $('select[name="import[menu_selection]"]').val();
        var template_type = $('input[name="import[template_type]"]:checked').val();
        var salary_target_time = $('.import-format_item_' + menu_selection + ' select[name="salary_target_time"]').val();
        if ($.inArray(menu_selection, SALARY_MENU_IMPORT) !== -1) {
            if (template_type == "1") {
                var template_id = $('select[name="import[template_id]"]').val();
                if (template_id == "0") {
                    show_alert('.content-alert', ['テンプレートを選択してください。'], 'alert-danger');
                    return false;
                }
            }
            if (!salary_target_time) {
                switch (menu_selection) {
                    case "payroll_calculation":
                        show_alert('.content-alert', ['給与処理月を選択してください。'], 'alert-danger');
                        break;
                    case "bonus_calculation":
                        show_alert('.content-alert', ['賞与処理月を選択してください。'], 'alert-danger');
                        break;
                    case "resign_calculation":
                        show_alert('.content-alert', ['退職金処理月を選択してください。'], 'alert-danger');
                        break;
                    case "monthly_change":
                        show_alert('.content-alert', ['算定期間を選択してください。'], 'alert-danger');
                        break;
                    case "year_end_adjustment":
                        show_alert('.content-alert', ['年調処理年を選択してください。'], 'alert-danger');
                        break;
                    case 'retroactive_calculation':
                        show_alert('.content-alert', ['遡及計算名称を選択してください。'], 'alert-danger');
                        break;
                    default:
                        break;
                }
                return false;
            }
        }
        return true;
    }

    function ValidateFileUpload()
    {
        var import_type = $('input[name="import[type]"]:checked').val();
        var file = document.getElementById('fileupload').files[0];
        var menu_selection = $('select[name="import[menu_selection]"]').val();
        var menu_detail = $('select[name="import[menu_detail]"]').val();
        if (menu_selection == 'accounting_information' || (import_type == 6 || menu_selection == 'workflow' || menu_selection == 'project' || menu_selection == 'setting_keihi' || (menu_selection == 'setting_hr' && $('.menu_details').val() == 'accounting_dept') || menu_selection == insurance_menu) && ($.inArray(menu_selection, SALARY_MENU_IMPORT) == -1)) {
            file = document.getElementById('zipfileupload').files[0];
        }
        if (file === undefined) {
            let name = '';
            if ($.inArray(menu_selection, SALARY_MENU_IMPORT) !== -1) {
                name = 'CSV';
            } else {
                if (DAT_MENU_IMPORT.includes(menu_detail)) {
                    name = 'DAT';
                } else {
                    name = import_type == 6 ? 'zip' : 'CSV';
                }
            }
            show_alert('.content-alert', [name + '形式のファイルを選択してください。'], 'alert-danger');
            return false;
        }
        var type_import = $('input[name="import[type]"]:checked').val();
        if (($.inArray(menu_selection, SALARY_MENU_IMPORT) !== -1) || type_import != 6 || menu_selection == 'workflow' || menu_selection == 'project') {
            if (DAT_MENU_IMPORT.includes(menu_detail)) {
                if (!file.name.toLowerCase().endsWith(".dat")) {
                    show_alert('.content-alert', ['DAT形式のファイルを選択してください。'], 'alert-danger');
                    return false;
                }
            } else {
                if (!file.name.toLowerCase().endsWith(".csv")) {
                    show_alert('.content-alert', ['正しいフォーマットのCSVをアップロードしてください。'], 'alert-danger');
                    return false;
                }
            }
        } else {
            if (!file.name.toLowerCase().endsWith(".zip")) {
                show_alert('.content-alert', ['アップロードするファイル形式が不正です。zip形式でアップロードしてください。'], 'alert-danger');
                return false;
            }
        }

        if (file.name.toLowerCase().endsWith(".zip") && file.size > 15728640) {
            show_alert('.content-alert', ['アップロードするファイルサイズの上限は15MBです。'], 'alert-danger');
            return false;
        }

        if (file.name.toLowerCase().endsWith(".csv") && file.size > 8388608) {
            show_alert('.content-alert', ['アップロードするファイルサイズの上限は8MBです。'], 'alert-danger');
            return false;
        }

        if (file.name.toLowerCase().endsWith(".dat") && file.size > 8388608) {
            show_alert('.content-alert', ['アップロードするファイルサイズの上限は8MBです。'], 'alert-danger');
            return false;
        }

        return true;
    }

