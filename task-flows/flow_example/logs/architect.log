     */
    public function filter_menu_select_by_role($is_template = true)
    {
        $role = $this->session->userdata('roles');
        $menu_selection = array_merge(
            MENU_SELECTION_IMPORT_TOP_OPTION,
            MENU_SELECTION_IMPORT_SALARY_OPTION,
