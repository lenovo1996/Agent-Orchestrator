        }

        if (
            (type === TYPE_UPLOAD_UPDATE || type === TYPE_UPLOAD_CREATE_UPDATE)
            && menu_selection === 'employee'
        ) {
            delete list_required['employees.last_name']
            delete list_required['employees.first_name']
            delete list_required['employees.joined_on']
        }
        if (onLegalEntity !== 1) {
            delete list_required['legal_entity_id'];
        }
        var key_required = Object.keys(list_required);
        var totalSelect = $('.import-option__table .selectbox').length;
        for (var i = 1; i <= totalSelect; i++) {
            var val = $('#select-' + i + ' input').attr('data-key');
            if (key_required.includes(val)) {
                key_required.splice(key_required.indexOf(val),1);
            }
        }

        if (key_required.length > 0) {
