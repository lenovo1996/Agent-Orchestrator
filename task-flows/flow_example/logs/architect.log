    function isBasicInfoMasterSetting(menu_detail)
    {
        return BASIC_INFO_MASTER_SETTING_DETAILS.indexOf(menu_detail) !== -1;
    }

    function isAffiliationOptionMasterSetting(menu_detail)
    {
        return AFFILIATION_OPTION_MASTER_SETTING_DETAILS.indexOf(menu_detail) !== -1;
    }

    function isPayrollMasterSetting(menu_detail)
    {
        return PAYROLL_MASTER_SETTING_DETAILS.indexOf(menu_detail) !== -1;
    }

    function applyPayrollMasterSettingImportState(currentEle, menu_detail)
    {
        var OptionType = currentEle.find('.option-type-import');
        currentEle.find('input[name="import[type]"][value="' + TYPE_UPLOAD_UPDATE + '"]').prop('checked', true);
        currentEle.find('.menu_details').removeClass('disabled').parents('.selectbox').show();
        OptionType.hide();
        currentEle.find('.import--type')[1].checked = true;
        currentEle.find('.select-template').show();
        currentEle.find('#type-add, #type-add-update, #type-add-update-history').hide();
        currentEle.find('#type-update').show();
        $('.select-template_item_setting_hr').show();
        var templateId = $('.select-template_item_setting_hr').find('[name="import[template_id]"]');
        templateId.find('option:eq(0)').prop('selected', true);
        templateId.find('option').not('option:eq(0)').hide();
        templateId.find('option[data-menu_detail="'+menu_detail+'"]').show();
        $('.radiobox.not-template-type').show();
        currentEle.find('select[name="import[template_id]"]').val('');
        $('#btnNextStep').attr('data-step', 1);
    }

    function isPaymentDestinationImport()
    {
        return $('select[name="import[menu_selection]"]').val() === MENU_SETTING_HR_OPTION_VALUE
            && $('select[name="import[menu_detail]"]').val() === 'payment_destination';
    }

