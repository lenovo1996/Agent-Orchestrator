    function yr_end_display_using_formula_select($select)
    {
        var selectValue = $select.val();
        var $item = $('#yr-end-using-formula-item');
        var showedValue = $item.data('value');

        if (selectValue == showedValue) {
            $item.attr({
                'style': 'display:flex',
            });
            $item.find('input[type="checkbox"]').prop('disabled', false);
        } else {
            $item.attr({
                'style': 'display:none',
            });
            $item.find('input[type="checkbox"]').prop('disabled', true);
        }
    }

    function generate_option_menu(options, place)
    {
        var html = '';
        $.each(options, function (key, value) {
            html += "<option value='" + key + "'>" + value + "</option>";
        });
        place.html(html);
    }

    function generate_option_template(type, place, is_radio, import_type, menu_detail)
    {
        var url = '';
        if (is_radio) {
            url = "/import/list_template_history_ajax";
            const menu_selection = $('select[name="import[menu_selection]"]').val();
            const menu_detail_mid = $('select[name="import[menu_mid_item]"]').val();
            if (menu_selection === 'employee' // 従業員管理
                && menu_detail_mid === 'employee_information' // 従業員情報
                && (import_type == 4 || import_type == 5) // 履歴追加 / 更新, 履歴削除
            ) {
                const params = {
                    menu_selection,
                    menu_detail: menu_detail_mid,
                    import_type,
                }
                url += `?${(new URLSearchParams(params).toString())}`
            }
        } else {
            url = "/import/list_template_ajax/" + type;
        }
        $.ajax({
            url: url,
            type: 'get',
            dataType: 'json',
            beforeSend: function () {},
        }).done(function (data) {
            place.find('option')
                .remove()
                .end()
                .append('<option value="0">未選択</option>');
            var customize_items = '';
            $.each(data, function (i, item) {
                if (is_radio) {
                    if (import_type == 5 && i == 'salary_unit_price'){
                        return true;
                    }
                    if ((i == 'working_time' || i == 'kintai_v2_working_time') && $('input[name="import[type]"]:checked').val() == 5) {
                        return true;
                    }
                        let is_num = /^-?\d+$/.test(i);
                    if (is_num) {
                        customize_items =  "<option value='"+i+"'>"+item+"</option>" + customize_items;
                        return true;
                    }
                    place.append("<option value='"+i+"'>"+item+"</option>");
                } else {
                    if (import_type != 2 && $.trim(item.name) == 'パスワード') {
                        return true;
                    }
                    place.append("<option value="+item.id+" data-menu_detail='"+item.menu_detail+"'>"+$.trim(item.name)+"</option>");
                }
                // place.val(0).trigger('change');
                if (type == 'setting_hr') {
                    var template_id = $('.select-template_item_setting_hr').find('[name="import[template_id]"]');
                    template_id.find('option').not('option:eq(0)').hide();
                    template_id.find('option[data-menu_detail="' + menu_detail + '"]').show();
                    if (menu_detail == 'payment_destination') {
                        template_id.find('option:eq(1)').prop('selected', true);
                    }
                }
            });
            place.append(customize_items);
        }).fail(function () {
            place.find('option').remove()
        });
    }

