        $labels = MENU_DETAIL_SETTING_HR_IMPORT;
        $label = $labels[$menu_detail] ?? '';
        $columns = $this->config->item('setting_hr');

        return $label !== '' && isset($columns[$label]) ? [$label => $columns[$label]] : [];
    }

