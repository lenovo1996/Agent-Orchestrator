<?php

namespace Jinjer\services\MasterSettingImport\Actions;

use Exception;
use Jinjer\Porto\BaseAction;
use Jinjer\services\MasterSettingImport\Support\MasterSettingImportRegistry;
use Jinjer\services\MasterSettingImport\Tasks\LoadMasterSettingDetailsTask;
use Jinjer\services\MasterSettingImport\Tasks\PersistRowsTask;
use Jinjer\services\MasterSettingImport\Tasks\ValidateRowsAgainstRoleScopeTask;
use Jinjer\services\MasterSettingImport\Tasks\ValidateRowsTask;

class ImportMasterSettingCsvAction extends BaseAction
{
    public function handle(int $companyId, array $rows, string $menuDetail, int $importType, bool $onlyValidate, array $historyImport = []): array
    {
        $schema = app(MasterSettingImportRegistry::class)->resolve($menuDetail);
        if ($schema === null) {
            return [
                'done' => true,
                'error_message' => [[2, '対象外のマスタ設定です。']],
                'total_success' => 0,
            ];
        }
        if (!in_array($importType, app(MasterSettingImportRegistry::class)->allowedImportTypes($menuDetail), true)) {
            return [
                'done' => true,
                'error_message' => [[2, 'インポート種別が正しくありません。']],
                'total_success' => 0,
            ];
        }

        try {
            $context = app(LoadMasterSettingDetailsTask::class)->handle($companyId, $schema['type']);
            $validated = app(ValidateRowsTask::class)->handle($rows, $importType, $schema, $context);
            $roleScopeValidated = app(ValidateRowsAgainstRoleScopeTask::class)->handle($companyId, $validated['valid_rows'], $schema);
            $errorMessage = array_merge($validated['error_message'], $roleScopeValidated['error_message']);

            if ($onlyValidate) {
                return [
                    'done' => true,
                    'error_message' => $errorMessage,
                    'total_success' => count($roleScopeValidated['valid_rows']),
                ];
            }

            $persisted = app(PersistRowsTask::class)->handle($roleScopeValidated['valid_rows'], $schema, $context, $historyImport);

            return [
                'done' => $persisted['done'],
                'error_message' => $errorMessage,
                'total_success' => $persisted['total_success'],
            ];
        } catch (Exception) {
            return ['done' => false, 'error_message' => [], 'total_success' => 0];
        }
    }
}

