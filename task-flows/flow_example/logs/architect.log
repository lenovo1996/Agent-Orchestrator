    function init_menu_detail()
    {
        var menu = $('select[name="import[menu_selection]"]').val();
        var currentEle = $('.import-format_item_' + menu);
        switch (menu) {
            case 'dept':
            case MENU_IMPORT_KINTAI_V2:
            case 'workflow':
                $(".menu_selection").trigger('change');
                break;
            case 'insurance':
                $(".menu_selection").trigger('change');
                $('.menu_details').removeClass('disabled').parents('.selectbox').show();
                currentEle.find('input[value="1"]').prop("checked", true);
                $('.select-template').hide();
                $('#btnNextStep').attr('data-step', 4);
                break;
            case 'setting_hr':
                generate_option_menu(menu_selection[menu]['detail'], $('.menu_details'));
                let menu_detail = $('select[name="import[menu_detail]"]').val();
                if (menu_detail == 'accounting_dept') {
                    $('.select-template').hide();
                    $('.import-format_item_setting_hr').find('#type-add, #type-update, #type-add-update-history').hide();
                    $('.import-format_item_setting_hr').find('input[value="3"]').prop("checked", true);
                } else if (isPayrollMasterSetting(menu_detail)) {
                    $('.select-template').addClass('select-template_item_setting_hr');
                    applyPayrollMasterSettingImportState(currentEle, menu_detail);
                } else {
                    if ( menu != 'workflow') {
                        $('.select-template').show();
                    } else {
                        currentEle.show();
                    }
                    $(".menu_selection").trigger('change');
                }
                $('.menu_details').removeClass('disabled').parents('.selectbox').show();
                break;
            default:
                $('.menu_details').addClass('disabled').html('').parents('.selectbox').hide();
                break
        }
    }

    var current_step = 1;
    $(document).on('click', '.import-step_list li', function () {
        const type = $('input[name="import[type]"]:checked').val();
        const menu_selection = $('select[name="import[menu_selection]"]').val();
        const menu_detail = $('select[name="import[menu_detail]"]').val();
        const step = $(this).closest('.import-step_list').attr('data-step');
        const click_step = $(this).find('.step_num').text();
        if (click_step && step <= current_step && click_step < step) {
            const back_step = (parseInt(step) - 1);
            if (back_step > 0) {
                if (type == '6' || menu_selection == 'workflow' || menu_selection == 'project' || menu_detail == 'accounting_dept' || menu_selection == 'setting_keihi' || menu_selection == insurance_menu) {
                    if (click_step == '1') {
                        $('.portlet-content-3-step:not(".portlet-content--import")').css('display', 'none');
                        $('.portlet-content[data-step="' + click_step + '"]:not(".portlet-content--import")').css('display', 'block');
                        $('.portlet-content[data-step="' + step + '"]:not(".portlet-content--import .portlet-content-3-step")').css('display', 'none');
                    } else {
                        $('.portlet-content-3-step[data-step="' + step + '"]:not(".portlet-content--import")').css('display', 'none');
                        $('.portlet-content-3-step[data-step="' + click_step + '"]:not(".portlet-content--import")').css('display', 'block');
                    }
                } else {
                    document.querySelectorAll(".portlet-content:not(.portlet-content--import)").forEach((el) => {
                        el.style.display = "none";
                    });
                    $('.portlet-content[data-step="' + click_step + '"]:not(".portlet-content--import .portlet-content-3-step")').css('display', 'block');
                }

                // Reset data
                for (var i = current_step; i > click_step; i--) {
